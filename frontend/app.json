{
  "expo": {
    "name": "Monefy",
    "slug": "monefy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3563E9"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.monefy.app"
    },
    "android": {
      "package": "com.monefy.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#3563E9"
      },
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"]
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Monefy to access your photos to scan bills.",
          "cameraPermission": "Allow Monefy to use the camera to scan bills."
        }
      ]
    ]
  }
}
